    benefits: [
      'Cat5e, Cat6, and Cat6a copper cabling installations',
      'Single-mode and multi-mode fibre optic solutions',
      'Professional cable management and documentation',
      'Testing and certification to industry standards',
      'Future-proof infrastructure design',
      'Minimal disruption to daily operations'
    ]
  },
  {
    id: 'data-centre',
    title: 'Data Centre Solutions',
    shortDescription: 'Complete data centre design and build services with network optimization.',
    fullDescription: 'From initial design to full implementation, we provide complete data centre solutions tailored to your specific requirements. Our expertise ensures maximum uptime, efficient cooling, proper power distribution, and scalable infrastructure that grows with your business.',
    image: dataCentreImg,
    benefits: [
      'Custom data centre design and planning',
      'Rack installation and cable management',
      'Power distribution and redundancy solutions',
      'Environmental monitoring systems',
      'Network optimization and performance tuning',
      'Disaster recovery and backup planning'
    ]
  },
  {
    id: 'cctv',
    title: 'CCTV & Access Control',
    shortDescription: 'High-performance security solutions with advanced network connectivity.',
    fullDescription: 'Protect your assets with advanced security solutions that integrate seamlessly with your network infrastructure. We deploy high-performance IP-based CCTV systems and sophisticated access control platforms that provide real-time monitoring and comprehensive security management.',
    image: cctvImg,
    benefits: [
      'IP-based HD and 4K camera systems',
      'Network video recorders with remote access',
      'Integrated access control systems',
      'Biometric and card-based authentication',
      'Mobile app monitoring and alerts',
      'Scalable solutions for any facility size'
    ]
  },
  {
    id: 'cloud',
    title: 'Cloud Solutions',
    shortDescription: 'Scalable cloud infrastructure to support your growing business needs.',
    fullDescription: 'Embrace the flexibility and scalability of cloud computing with our comprehensive cloud services. We help businesses migrate, manage, and optimize their cloud infrastructure across leading platforms, ensuring cost-effectiveness, security, and seamless integration with existing systems.',
    image: cloudImg,
    benefits: [
      'Cloud migration and implementation services',
      'Multi-cloud and hybrid cloud strategies',
      'Cloud backup and disaster recovery',
      'Scalable storage and computing resources',
      '24/7 cloud infrastructure monitoring',
      'Cost optimization and resource management'
    ]
  },
  {
    id: 'cybersecurity',
    title: 'Cybersecurity Services',
    shortDescription: 'Comprehensive security measures to protect your IT infrastructure.',
    fullDescription: 'In today\'s threat landscape, robust cybersecurity is essential. We provide comprehensive security solutions that protect your network, data, and systems from evolving cyber threats. Our multi-layered approach ensures your business stays secure while maintaining operational efficiency.',
    image: cybersecurityImg,
    benefits: [
      'Firewall deployment and management',
      'Intrusion detection and prevention systems',
      'Vulnerability assessments and penetration testing',
      'Email security and anti-phishing solutions',
      'Employee security awareness training',
      'Compliance and security policy development'
    ]
  },
  {
    id: 'managed-it',
    title: 'Managed IT Support',
    shortDescription: '24/7 IT support and monitoring to ensure seamless operations.',
    fullDescription: 'Focus on your core business while we handle your IT infrastructure. Our managed IT services provide proactive monitoring, maintenance, and support to ensure your systems run smoothly 24/7. We become your dedicated IT department, available whenever you need us.',
    image: managedItImg,
    benefits: [
      '24/7 network monitoring and support',
      'Proactive maintenance and patch management',
      'Help desk and user support services',
      'Performance optimization and reporting',
      'Strategic IT planning and consultation',
      'Predictable monthly costs with no surprises'
    ]
  },
  {
    id: 'audiovisual',
    title: 'Audio Visual Solutions',
    shortDescription: 'We transform spaces into immersive experiences with cutting-edge audio visual technology.',
    fullDescription: 'Transform your meeting rooms, conference halls, and presentation spaces with cutting-edge audio visual technology. We design and install integrated AV systems that enhance communication, collaboration, and engagement while maintaining simplicity and reliability.',
    image: audioVisualImg,
    benefits: [
      'Conference room and boardroom AV systems',
      'Video conferencing solutions (Zoom, Teams, etc.)',
      'Digital signage and display systems',
      'Professional audio systems and acoustics',
      'Control systems and automation',
      'Training and ongoing technical support'
    ]
  },
  {
    id: 'ups',
    title: 'UPS Systems',
    shortDescription: 'We provide reliable uninterruptible power systems for seamless business continuity always.',
    fullDescription: 'Protect your critical systems from power disruptions with reliable uninterruptible power supply solutions. We design, install, and maintain UPS systems that provide seamless backup power, ensuring business continuity during outages and protecting sensitive equipment from power fluctuations.',
    image: upsImg,
    benefits: [
      'Right-sized UPS solutions for your needs',
      'Single-phase and three-phase systems',
      'Battery backup and runtime calculations',
      'Remote monitoring and management',
      'Preventive maintenance programs',
      'Integration with building management systems'
    ]
  },
  {
    id: 'biometric',
    title: 'Biometric Systems',
    shortDescription: 'Biometric systems ensuring secure network access and efficient cable management solutions.',
    fullDescription: 'Enhance security and streamline access management with advanced biometric authentication systems. From fingerprint scanners to facial recognition, we implement secure, user-friendly biometric solutions that integrate seamlessly with your existing security infrastructure and network.',
    image: biometricImg,
    benefits: [
      'Fingerprint and facial recognition systems',
