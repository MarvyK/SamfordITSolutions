  },
  {
    id: 'wifi-optimization',
    title: 'WiFi Optimization Solutions',
    shortDescription: 'Enterprise-grade wireless networks designed for optimal performance and coverage.',
    fullDescription: 'Eliminate dead zones and connectivity issues with our professional WiFi optimization services. We design, deploy, and optimize wireless networks that deliver consistent, high-speed connectivity throughout your facility. From site surveys to ongoing management, we ensure your wireless infrastructure meets the demands of modern business.',
    image: wifiImg,
    benefits: [
      'Comprehensive wireless site surveys and heatmapping',
      'Enterprise-grade access point deployment',
      'Guest network configuration and management',
      'Seamless roaming across multiple access points',
      'Performance monitoring and optimization',
      'Scalable solutions for any facility size'
    ]
  },
  {
    id: 'fixed-wireless',
    title: 'Fixed Wireless Solutions',
    shortDescription: 'High-speed wireless connectivity without the need for traditional fiber or cable infrastructure.',
    fullDescription: 'Get reliable, high-speed internet connectivity in locations where traditional wired infrastructure is unavailable or impractical. Our fixed wireless solutions provide fast, secure broadband connectivity using advanced wireless technology, perfect for remote offices, temporary sites, or as a backup connection for business continuity.',
    image: fixedWirelessImg,
    benefits: [
      'Rapid deployment without trenching or cabling',
      'High-bandwidth connectivity up to gigabit speeds',
      'Cost-effective alternative to fiber installation',
      'Reliable backup internet connection',
      'Point-to-point and point-to-multipoint options',
      'Professional installation and ongoing support'
    ]
  },
  {
    id: 'smart-home',
    title: 'Smart Home Solutions',
    shortDescription: 'Integrated home automation systems for enhanced comfort, security, and energy efficiency.',
    fullDescription: 'Transform your home into an intelligent living space with our comprehensive smart home solutions. We integrate lighting, climate control, security, entertainment, and more into a seamless, user-friendly system you can control from anywhere. Experience the convenience, security, and energy savings of a fully automated home.',
    image: smartHomeImg,
    benefits: [
      'Integrated lighting and climate control automation',
      'Smart security systems with remote monitoring',
      'Whole-home audio and video distribution',
      'Voice control integration (Alexa, Google, etc.)',
      'Energy management and monitoring',
      'Professional installation and personalized setup'
    ]
  },
  {
    id: 'voip',
    title: 'VOIP Services',
    shortDescription: 'Advanced voice over IP phone systems that reduce costs and enhance communication.',
    fullDescription: 'Modernize your business communications with feature-rich VOIP phone systems. Our cloud-based and on-premise solutions deliver crystal-clear voice quality, advanced call management features, and seamless integration with your existing business tools. Reduce telecommunications costs while gaining flexibility and mobility for your workforce.',
    image: voipImg,
    benefits: [
      'Cloud-based and on-premise VOIP solutions',
      'Advanced call routing and auto-attendant features',
      'Mobile apps for remote and hybrid workers',
      'Integration with CRM and business applications',
      'Significant cost savings over traditional phone lines',
      'Scalable systems that grow with your business'
    ]
  }
];
---

<Layout 
  title="Our Services - Samford IT Solutions" 
  description="Comprehensive IT solutions designed to meet your business needs and drive growth. From network cabling to cloud solutions, we've got you covered."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative text-white py-20 thegreen">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <div class="flex-1 max-w-4xl">
        <h1 class="mb-6 text-5xl economica-bold">Our Services</h1>
        <p class="text-xl text-primary-100 leading-relaxed mb-8">
          Comprehensive IT solutions designed to meet your business needs and drive growth. From network cabling to cloud solutions, we provide end-to-end managed IT services.
        </p>
      </div>
      <div class="flex-shrink-0">
        <Image 
          src={servicesImg} 
          alt="Our Services" 
          class="w-64 h-64 md:w-80 md:h-80 object-cover rounded-lg"
        />
      </div>
    </div>
  </div>
</section>

    <!-- Sticky Navigation -->
    <nav class="bg-white sticky z-50 shadow-md" style="top: 100px;">
      <div class="container-custom">
        <ul class="flex flex-wrap gap-4 py-4 justify-center text-sm md:text-base">
          {services.map(service => (
            <li>
              <a href={`#${service.id}`} class="text-primary-600 hover:text-primary-700 font-medium transition-colors">
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- Services Sections -->
    <div class="bg-gray-50">
      {services.map((service, index) => (
        <section id={service.id} class="section scroll-mt-20">
          <div class="container-custom">
            <div class="bg-white rounded-xl shadow-lg p-8">
              <!-- Service Header -->
              <div class="flex flex-col md:flex-row gap-6 mb-8 pb-6 border-b-4 border-primary-600">
                <div class="flex flex-col md:flex-row items-center gap-6 md:gap-4">
                  <div class="flex-shrink-0">
                    <Image 
                      src={service.image} 
                      alt={service.title} 
                      class="w-24 h-22 md:w-32 md:h-29"
                    />
                  </div>
                  <div class="flex-1 text-center md:text-left">
                    <h2 class="text-3xl md:text-4xl economica-bold">
                      {service.title}
                    </h2>
                  </div>
                </div>
              </div>

              <!-- Service Description -->
              <p class="text-lg text-gray-700 leading-relaxed mb-8">
                {service.fullDescription}
              </p>

              <!-- Benefits Grid -->
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                {service.benefits.map(benefit => (
                  <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-lg border-l-4 border-primary-600">
                    <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-gray-700">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- CTA Section -->
    <section class="section thegreen text-white text-center">
      <div class="container-custom max-w-3xl">
        <h2 class="text-4xl economica-bold mb-4">Ready to Transform Your IT Infrastructure?</h2>
        <p class="text-xl text-primary-100 mb-8">
          Let's discuss how we can tailor these solutions to meet your specific business needs.
        </p>
        <a href={`${base}/contact`} class="btn border-2 bg-primary-500 text-primary-900 hover:bg-gray-100">
          Get in Touch Today
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
