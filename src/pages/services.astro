---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// Import all service images
import networkCablingImg from '/public/images/icon_network_cabling.png';
import dataCentreImg from '/public/images/icon_data_center.png';
import cctvImg from '/public/images/icons_cctv_accesscontrol.png';
import cloudImg from '/public/images/icon_cloud_services.png';
import cybersecurityImg from '/public/images/icon_cybersecurity.png';
import managedItImg from '/public/images/icon_managed_it.png';
import audioVisualImg from '/public/images/icon_audiovisual.png';
import upsImg from '/public/images/icon_ups.png';
import biometricImg from '/public/images/icon_biometrics.png';
import itRelocationImg from '/public/images/icon_relocation_services.png';
import wifiImg from '/public/images/icon_wifi.png';
import fixedWirelessImg from '/public/images/icon_fixedWireless.png';
import smartHomeImg from '/public/images/icons_cctv_accesscontrol.png';
import voipImg from '/public/images/icon_voip.png';
import servicesImg from '/public/images/icon_all_services.png';


const base = import.meta.env.BASE_URL;

const services = [
  {
    id: 'network-cabling',
    title: 'Network Cabling',
    shortDescription: 'Professional LAN installations with copper and fibre optic solutions for optimal performance.',
    fullDescription: 'Professional structured cabling solutions form the backbone of your IT infrastructure. We deliver comprehensive LAN installations using both copper and fibre optic technologies, ensuring optimal performance, reliability, and scalability for your growing business needs.',
